tests/load/results/*.json
benchmarks/results/*.json

# ── Environment & Secrets ─────────────────────────
.env
.env.local
.env.*.local
!.env.example
!.env.config.example
certs/
.orange-session/
k8s/secret.yaml
secret.yaml
*.momo-profiles.json

# ── OS Files ──────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor & IDE ──────────────────────────────────
.idea/
.vs/
.vscode/settings.json
.kilo/
.kiro/

