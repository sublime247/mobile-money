.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# ── Package Manager (using npm) ──────────────────
pnpm-lock.yaml
pnpm-workspace.yaml

# ── Playwright ────────────────────────────────────
playwright-report/
test-results/

