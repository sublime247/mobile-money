{
  "name": "@stellar-bridge/sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Official TypeScript & JavaScript SDK client for Mobile Money Bridge API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && mv dist/cjs/index.js dist/index.cjs && rm -rf dist/cjs",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "stellar",
    "mobile-money",
    "sdk",
    "sep-10",
    "sep-12",
    "sep-24",
    "sep-38",
    "remittance"
  ],
  "author": "Stellar Wave Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
