    {
      "name": "1. Auth",
      "description": "SEP-10 Stellar challenge-response authentication and JWT session management",
      "item": [
        {
          "name": "SEP-10: Request Challenge Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains challenge transaction XDR\", function () {",
                  "    pm.expect(jsonData.transaction).to.be.a('string');",
                  "    pm.environment.set(\"challenge_xdr\", jsonData.transaction);",
                  "    pm.collectionVariables.set(\"challenge_xdr\", jsonData.transaction);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sep10/auth?account={{stellar_public_key}}&home_domain={{home_domain}}",
              "host": ["{{base_url}}"],
              "path": ["sep10", "auth"],
              "query": [
                {
                  "key": "account",
                  "value": "{{stellar_public_key}}"
                },
                {
                  "key": "home_domain",
                  "value": "{{home_domain}}"
                }
              ]
            }
          }
        },
        {
          "name": "SEP-10: Auto-Sign Challenge & Exchange for JWT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Automated SEP-10 Challenge signing pre-request script",
                  "var pubKey = pm.environment.get(\"stellar_public_key\") || pm.collectionVariables.get(\"stellar_public_key\");",
                  "var secKey = pm.environment.get(\"stellar_secret_key\") || pm.collectionVariables.get(\"stellar_secret_key\");",
                  "var baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
                  "var homeDomain = pm.environment.get(\"home_domain\") || pm.collectionVariables.get(\"home_domain\");",
                  "",
                  "// Check if we need to fetch a fresh challenge",
                  "var currentChallenge = pm.environment.get(\"challenge_xdr\") || pm.collectionVariables.get(\"challenge_xdr\");",
                  "",
                  "if (!currentChallenge) {",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/sep10/auth?account=' + pubKey + '&home_domain=' + homeDomain,",
                  "        method: 'GET'",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            var data = res.json();",
                  "            pm.environment.set(\"challenge_xdr\", data.transaction);",
                  "            pm.collectionVariables.set(\"challenge_xdr\", data.transaction);",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"JWT token received and stored\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"transaction\": \"{{challenge_xdr}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/sep10/auth",
              "host": ["{{base_url}}"],
              "path": ["sep10", "auth"]
            }
          }
        },
        {
          "name": "Standard Login (Phone / OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.environment.set(\"jwt_token\", data.token);",
                  "    pm.collectionVariables.set(\"jwt_token\", data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone_number\": \"+237670000000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify Token",
